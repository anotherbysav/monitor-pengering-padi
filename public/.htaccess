# =============================================================
#  Monitor Pengering Padi - rewrite Apache
#  Semua request diarahkan ke public/index.php (front controller),
#  kecuali file/folder asli (aset CSS/JS) yang dilayani langsung.
# =============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1) Kalau file/folder benar-benar ada -> layani langsung (aset statis)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2) Selain itu (API, SPA route) -> teruskan ke front controller
    RewriteRule ^ index.php [L]
</IfModule>

# Paksa PHP menangani root "/" (JANGAN index.html, agar /api tetap hidup)
DirectoryIndex index.php

# Jangan tampilkan isi folder
Options -Indexes

# Tolak file tersembunyi (.env, .git, dll)
<FilesMatch "(^\.|\.(sql|log|ini|md)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Cegah download kode PHP langsung
<FilesMatch "\.(php|phtml)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</FilesMatch>

# Header keamanan dasar
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
</IfModule>

ServerSignature Off
